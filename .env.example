# development or production. Production refuses to start if API_KEY, SERVICE_TOKEN, a provider
# key, DATABASE_URL or REDIS_URL is empty: an empty secret does not fail, it opens the door.
ENVIRONMENT=development

# LLM providers (never commit real keys: copy this file to .env)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Model used for the listing review, in LiteLLM format (provider/model)
LLM_MODEL=anthropic/claude-haiku-4-5
# Model the router falls back to when the primary one fails. Empty disables the fallback.
LLM_FALLBACK_MODEL=openai/gpt-5.4-mini
# Attempts Instructor makes when the model answer does not fit the schema
LLM_MAX_RETRIES=2

# The judge checks what the generator wrote (grounding check, agent critic), on the other provider
# so it does not share the generator's blind spots (ADR 0023).
LLM_JUDGE_MODEL=openai/gpt-5.4-mini
LLM_JUDGE_FALLBACK_MODEL=anthropic/claude-haiku-4-5
# The reranker. Empty uses the generator's models.
LLM_RERANK_MODEL=
LLM_RERANK_FALLBACK_MODEL=
# Bounds on every model call: a hung call becomes a timeout, a truncated answer a named failure.
LLM_TIMEOUT_SECONDS=45
LLM_MAX_TOKENS=4000
LLM_TEMPERATURE=0

# The agent review: hard limits on every run (ADR 0024).
AGENT_MAX_ITERATIONS=6
AGENT_TIMEOUT_SECONDS=90
AGENT_MAX_FRAGMENTS=5
# graph: LangGraph with the state checkpointed in Postgres after every node. loop: the hand-written
# loop it was built from (ADR 0026).
AGENT_ORCHESTRATOR=graph
# Actor-critic-boss (ADR 0025). The critic runs on LLM_JUDGE_MODEL, the other provider.
AGENT_CRITIC_ENABLED=true
AGENT_CRITIC_MIN_CONFIDENCE=0.7
AGENT_CRITIC_ESCALATE_BELOW=0.4
AGENT_MAX_REVIEW_ATTEMPTS=2
# An escalated review pauses for a person before it is published (ADR 0027).
AGENT_HUMAN_REVIEW_ENABLED=true
# Propose the listing corrected for its final findings (ADR 0028).
AGENT_REWRITE_ENABLED=true

# Exact-match review cache. Empty disables it; docker compose sets it for you.
REDIS_URL=
CACHE_TTL_SECONDS=86400

# Corpus store (PostgreSQL + pgvector), which also keeps the feedback of #51. Empty disables it:
# the listing review runs without a database, and a vote answers 503. Docker Compose sets it for you; to work locally against that container use
# postgresql+asyncpg://rental:rental@localhost:5432/rental
DATABASE_URL=

# Stored with every chunk so a reindex is traceable; bump it when the corpus build changes.
CORPUS_VERSION=1
# Articles longer than this are split by paragraph (see docs/decisions/0009).
CHUNK_MAX_CHARS=6000

# Embeddings. Changing the model re-embeds the corpus on the next `make embed`; changing the
# dimensions needs a migration too, because the vector column is typed.
EMBEDDING_MODEL=openai/text-embedding-3-large
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=100

# Retrieval. Below RETRIEVAL_MIN_SCORE a result is noise and is dropped, even if that leaves none.
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.40

# A model reorders the candidates before the answer is written. Measured in ADR 0013: recall@1
# goes from 82% to 91%, for ~0.009 USD and ~2.4 s. The pool is what makes it work: with 10
# candidates instead of 20 the gain disappears entirely.
RERANK_ENABLED=true
RERANK_POOL=20

# A model checks that the cited articles actually support the answer's claims. One unsupported
# legal claim turns the answer into "I don't know": see ADR 0014.
GROUNDING_ENABLED=true
# Share of the answer's claims the cited articles must support. At 1.0 the check rejected 23%
# of correct answers, mostly over framing sentences: measured in ADR 0014.
GROUNDING_MIN_CONFIDENCE=0.7

# Access (ADR 0020). SERVICE_TOKEN: may you talk to the service at all (the UI sends it).
# API_KEY: which endpoints you may use (every business router). Empty leaves them open, right for
# local development and logged on every request. RAG_API_KEY, the old name of API_KEY, is still read.
SERVICE_TOKEN=
API_KEY=
# The shared login of the UI (ADR 0034). Empty means no login, right for local development; the
# UI in production shows nothing without both. Use a long password: a new session resets the lock.
UI_USERNAME=
UI_PASSWORD=
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# Model spend per UTC day. At the cap the service stops calling models until midnight (503).
DAILY_SPEND_CAP_USD=2.0
