# LLM providers (never commit real keys: copy this file to .env)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Model used for the listing review, in LiteLLM format (provider/model)
LLM_MODEL=anthropic/claude-haiku-4-5
# Model the router falls back to when the primary one fails. Empty disables the fallback.
LLM_FALLBACK_MODEL=openai/gpt-5.4-mini
# Attempts Instructor makes when the model answer does not fit the schema
LLM_MAX_RETRIES=2
